# Copie para .env e ajuste. O .env NÃO vai para o Git.
DATABASE_URL=postgresql://sonar:sonar@localhost:5432/sonar
# dev = login só com e-mail (testes) | cognito = produção na AWS
AUTH_MODO=dev
DEV_JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio-de-32+-caracteres
CORS_ORIGENS=http://localhost:5173,http://localhost:8000
SAL_HASH=troque-este-sal
# UFs com pacote de regras ligado (ondas): AM primeiro
UFS_REGRAS=AM
# parceiro de dados pagos (roubo/furto, gravame, RENAJUD, leilão privado, débitos):
# ficticio (dados-referencia/ficticios) | apibrasil | consultarplaca | anycar | zapcar  (Fase 0)
PARCEIRO=ficticio
PARCEIRO_CHAVE=
# usuário criado por: python -m coleta.semear
SEED_EMAIL=voce@exemplo.com.br
